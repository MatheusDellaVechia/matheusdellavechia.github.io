---
import PostCard from './PostCard.astro';
import { getCollection } from 'astro:content';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang];
const blogBase = lang === 'en' ? '/en/blog' : '/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<section class="py-4">
  <h1
    class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-white"
  >
    {c.blog.title}
  </h1>
  <p class="mt-3 text-zinc-600 dark:text-zinc-400">
    {c.blog.subtitle}
  </p>
</section>

<div class="mt-6 grid gap-4 sm:grid-cols-2">
  {
    posts.map((post, i) => (
      <PostCard
        href={`${blogBase}/${post.id}/`}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        index={i}
        animate={true}
        locale={c.dateLocale}
        readLabel={c.postCard.read}
      />
    ))
  }
</div>

{
  posts.length === 0 && (
    <p class="mt-6 text-zinc-500 dark:text-zinc-400">{c.blog.empty}</p>
  )
}
