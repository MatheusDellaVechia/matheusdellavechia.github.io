---
import { SITE_TITLE, SOCIALS } from '../consts';
const year = new Date().getFullYear();

interface Props {
  containerClass?: string;
}
const { containerClass = 'max-w-3xl' } = Astro.props;

const linkClass =
  'text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white';
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div
    class:list={[
      'mx-auto flex flex-col items-center justify-between gap-3 px-5 py-8 text-sm text-zinc-500 sm:flex-row sm:px-6 dark:text-zinc-400',
      containerClass,
    ]}
  >
    <p>© {year} {SITE_TITLE}</p>
    <div class="flex items-center gap-4">
      <a class={linkClass} href={SOCIALS.github} target="_blank" rel="noopener"
        >GitHub</a
      >
      <a
        class={linkClass}
        href={SOCIALS.linkedin}
        target="_blank"
        rel="noopener">LinkedIn</a
      >
    </div>
  </div>
</footer>
