---
import PostCard from './PostCard.astro';
import { SOCIALS } from '../consts';
import { content, type Lang } from '../i18n/content';
import { getPostsByLang, postSlug } from '../lib/blog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang];
const blogBase = lang === 'en' ? '/en/blog' : '/blog';

const posts = (await getPostsByLang(lang)).slice(0, 3);
---

<!-- ============ HERO / APRESENTAÇÃO ============ -->
<section class="pt-4 pb-12 sm:pt-6">
  <div class="grid items-center gap-8 lg:grid-cols-5 lg:gap-12">
    <!-- Coluna de texto -->
    <div class="lg:col-span-3">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400"
      >
        <span
          class="inline-flex h-2 w-2 rounded-full bg-indigo-500"
          aria-hidden="true"></span>
        {c.hero.badge}
      </div>

      <h1
        class="mt-6 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl dark:text-white"
      >
        {c.hero.greeting}{' '}<span
          class="bg-gradient-to-r from-indigo-500 to-emerald-500 bg-clip-text text-transparent"
          >Matheus Della Vechia</span
        >.
      </h1>

      <p
        class="mt-4 text-xl font-semibold text-zinc-700 sm:text-2xl dark:text-zinc-200"
      >
        {c.hero.headline}
      </p>

      <p
        class="mt-5 text-lg leading-relaxed text-zinc-600 dark:text-zinc-300"
        set:html={c.hero.pitchHtml}
      />

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={blogBase}
          class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
        >
          {c.hero.ctaBlog}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={c.paths.about}
          class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >
          {c.hero.ctaAbout}
        </a>
        <a
          href={SOCIALS.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >
          GitHub
        </a>
      </div>
    </div>

    <!-- Card de perfil -->
    <aside class="lg:col-span-2">
      <div
        class="animate-fade-up relative overflow-hidden rounded-2xl border border-zinc-200 bg-gradient-to-br from-zinc-50 to-white p-6 dark:border-zinc-800 dark:from-zinc-900 dark:to-zinc-950"
      >
        <div
          class="pointer-events-none absolute -top-16 -right-16 h-40 w-40 rounded-full bg-indigo-500/10 blur-2xl dark:bg-indigo-500/20"
          aria-hidden="true"
        >
        </div>

        <div class="flex flex-col items-center text-center">
          <div
            class="rounded-full bg-gradient-to-br from-indigo-500 to-emerald-500 p-1"
          >
            <img
              src="/profile.svg"
              alt="Foto de Matheus Della Vechia"
              width="112"
              height="112"
              class="h-28 w-28 rounded-full object-cover ring-2 ring-white dark:ring-zinc-950"
            />
          </div>
          <h2 class="mt-4 text-lg font-bold text-zinc-900 dark:text-white">
            Matheus Della Vechia
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            {c.hero.role}
          </p>
          <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">
            {c.hero.locationEdu}
          </p>
        </div>

        <div
          class="mt-5 flex flex-wrap justify-center gap-1.5 border-t border-zinc-200 pt-5 dark:border-zinc-800"
        >
          {
            c.hero.chips.map((t) => (
              <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {t}
              </span>
            ))
          }
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- ============ DESTAQUE VISUAL ============ -->
<section class="animate-fade-up mt-4">
  <div
    class="relative overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800"
  >
    <img
      src="/showcase.svg"
      alt="Imagem de destaque"
      width="1200"
      height="500"
      loading="lazy"
      class="h-52 w-full object-cover sm:h-64 md:h-72"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="absolute bottom-0 left-0 p-6 sm:p-8">
      <p class="text-lg font-semibold text-white sm:text-2xl">
        {c.showcase.title}
      </p>
      <p class="mt-1 max-w-lg text-sm text-white/80">
        {c.showcase.subtitle}
      </p>
    </div>
  </div>
</section>

<!-- ============ ÚLTIMOS ARTIGOS ============ -->
{
  posts.length > 0 && (
    <section class="mt-10">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-bold text-zinc-900 dark:text-white">
          {c.latest.title}
        </h2>
        <a
          href={blogBase}
          class="text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
        >
          {c.latest.all}
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {posts.map((post, i) => (
          <PostCard
            href={`${blogBase}/${postSlug(post.id)}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            index={i}
            animate={true}
            locale={c.dateLocale}
            readLabel={c.postCard.read}
          />
        ))}
      </div>
    </section>
  )
}

<!-- ============ TECNOLOGIAS & EXPERIÊNCIA ============ -->
<section class="mt-8 border-t border-zinc-200 pt-10 dark:border-zinc-800">
  <h2 class="text-xl font-bold text-zinc-900 dark:text-white">
    {c.tech.title}
  </h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      c.tech.groups.map((group) => (
        <div class="rounded-2xl border border-zinc-200 p-5 dark:border-zinc-800">
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-white">
            {group.title}
          </h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- ============ PROJETOS EM DESTAQUE ============ -->
<section class="mt-8 border-t border-zinc-200 pt-10 dark:border-zinc-800">
  <h2 class="text-xl font-bold text-zinc-900 dark:text-white">
    {c.projects.title}
  </h2>
  <div class="mt-6 grid gap-4">
    {
      c.projects.items.map((project) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener"
          class="group block rounded-2xl border border-zinc-200 p-5 transition-all hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-lg hover:shadow-zinc-200/60 dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:shadow-none"
        >
          <div class="flex items-center gap-2">
            <h3 class="text-lg font-semibold text-zinc-900 transition-colors group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400">
              {project.name}
            </h3>
            <span
              class="text-zinc-400 transition-transform group-hover:translate-x-0.5 dark:text-zinc-500"
              aria-hidden="true"
            >
              ↗
            </span>
          </div>
          <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            {project.description}
          </p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {project.tags.map((t) => (
              <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                {t}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
