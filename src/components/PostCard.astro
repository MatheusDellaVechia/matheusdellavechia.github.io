---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  index?: number;
  animate?: boolean;
  locale?: string;
  readLabel?: string;
}

const {
  href,
  title,
  description,
  pubDate,
  tags,
  index = 0,
  animate = false,
  locale = 'pt-BR',
  readLabel = 'Ler artigo',
} = Astro.props;
const dateStr = pubDate.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={href}
  class:list={[
    'group block rounded-2xl border border-zinc-200 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-200/40 dark:border-zinc-800 dark:hover:border-indigo-500/50 dark:hover:shadow-none',
    animate && 'animate-fade-up',
  ]}
  style={animate ? `animation-delay:${Math.min(index, 8) * 90}ms` : undefined}
>
  <time
    datetime={pubDate.toISOString()}
    class="text-xs font-medium text-zinc-500 dark:text-zinc-400">{dateStr}</time
  >
  <h3
    class="mt-2 text-lg font-semibold text-zinc-900 transition-colors group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400"
  >
    {title}
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
    {description}
  </p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
            #{t}
          </span>
        ))}
      </div>
    )
  }
  <span
    class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400"
  >
    {readLabel}
    <span
      class="transition-transform group-hover:translate-x-1"
      aria-hidden="true">→</span
    >
  </span>
</a>
