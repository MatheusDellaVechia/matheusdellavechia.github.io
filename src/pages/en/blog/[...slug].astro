---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { content } from '../../../i18n/content';
import {
  getPostsByLang,
  getTranslatedSlugs,
  postSlug,
} from '../../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPostsByLang('en');
  const ptSlugs = await getTranslatedSlugs('pt-br');
  return posts.map((post) => {
    const slug = postSlug(post.id);
    return {
      params: { slug },
      props: {
        post,
        altHref: ptSlugs.has(slug) ? `/blog/${slug}/` : '/blog',
      },
    };
  });
}) satisfies GetStaticPaths;

const lang = 'en';
const c = content[lang];
const { post, altHref } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString(c.dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  altHref={altHref}
>
  <article class="mx-auto max-w-3xl">
    <a
      href={c.paths.blog}
      class="text-sm font-medium text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
    >
      {c.post.back}
    </a>

    <header class="mt-4 border-b border-zinc-200 pb-6 dark:border-zinc-800">
      <div
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400"
      >
        <time datetime={post.data.pubDate.toISOString()}
          >{fmt(post.data.pubDate)}</time
        >
        {
          post.data.updatedDate && (
            <span>
              · {c.post.updated} {fmt(post.data.updatedDate)}
            </span>
          )
        }
      </div>
      <h1
        class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-white"
      >
        {post.data.title}
      </h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">
        {post.data.description}
      </p>
      {
        post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {post.data.tags.map((t) => (
              <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                #{t}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-zinc mt-8 max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-pre:rounded-xl prose-pre:border prose-pre:border-zinc-200 dark:prose-pre:border-zinc-800"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
