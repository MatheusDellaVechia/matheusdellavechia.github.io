import BlogListing from '../../../components/BlogListing.astro';
import { content } from '../../../i18n/content';

const lang = 'en';
const m = content[lang].meta;
---

<BaseLayout title={m.blogTitle} description={m.blogDesc} lang={lang}>
  <BlogListing lang={lang} />
</BaseLayout>
